<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Android 12+ always draws a launch screen of its own. It is used here
        as nothing but the ground the app starts on: the ink colour, with no
        icon and no exit animation.

        The mark is the app's own splash screen (src/components/SplashScreen.vue)
        and it is the only one - a system splash that also shows the logo
        reads as a second, static splash before the real one.
    -->
    <style name="LaunchScreenTheme" parent="LaunchScreenThemeBase">
        <item name="android:windowSplashScreenBackground">@color/ns_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

</resources>
