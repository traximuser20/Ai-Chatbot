<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive launcher icon.

    The layers are the brand tile and the mark, generated by
    design/logo/build-assets.py. The foreground carries the mark inside the
    66% safe zone so no launcher mask ever clips it, and the monochrome layer
    is the same shape as a single colour for the themed icons of Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
