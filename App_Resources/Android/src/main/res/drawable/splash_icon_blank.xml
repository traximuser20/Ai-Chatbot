<?xml version="1.0" encoding="utf-8"?>
<!--
    An invisible drawable, used as the Android 12+ launch screen icon.

    The system splash screen has to have an icon, but showing the mark there
    as well would make the app look like it has two splash screens: the
    system one (a static logo on a flat ground) and the app's own, which
    animates. So the system splash is only the ground, and the mark appears
    once the app takes over.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
